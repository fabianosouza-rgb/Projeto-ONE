
@model Projeto_ONE.Data.Entidade.Tarefa

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h3>Editar Descrição da Tarefa</h3>
<hr />

@using (Html.BeginForm("ConfirmarAlteracao", "Agenda", FormMethod.Post))
{
    @Html.HiddenFor(model => model.IdTarefa)<div class="form-group">
        <label>Título:</label>
        <input type="text" class="form-control" value="@Model.Titulo" disabled />
    </div>

    <div class="form-group">
        @Html.LabelFor(model => model.Descricao)
        @Html.TextBoxFor(model => model.Descricao, new { @class = "form-control", rows = "5" })
    </div>
    <br />

    <button type="submit" class="btn btn-primary">Salvar Alterações</button>
    @Html.ActionLink("Cancelar", "Consulta", null, new { @class = "btn btn-default" })

}