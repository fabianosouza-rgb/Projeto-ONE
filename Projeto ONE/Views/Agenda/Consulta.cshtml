

@model Projeto_ONE.Models.AgendaModelConsulta
   

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

    <h3>Consulta de Tarefas</h3>
    @Html.ActionLink("Voltar", "Cadastro")
    <hr />
    <div class="row">
        <div class="cold-md-3">
            @using (Html.BeginForm("Consulta", "Agenda", FormMethod.Post))
            {
                <div style="color: red;">
                    @Html.ValidationSummary()
                </div>

                @Html.LabelFor(model => model.DataIni)
                @Html.TextBoxFor(model => model.DataIni,
               new { @class = "form-control", @type = "datetime-local" })
                <br />

                @Html.LabelFor(model => model.DataFim)
                @Html.TextBoxFor(model => model.DataFim,
                new { @class = "form-control", @type = "datetime-local" })
                <br />

                <input type="submit" value="Realizar Pesquisa"
                       class=" btn btn-primary btn-block" />
                <hr />

                @ViewBag.Mensagem
             }
        </div>
            <div class="col-md-9">

                @if (Model != null && Model.ListagemTarefas != null)
                {
                    if (Model.ListagemTarefas.Count > 0)
                    {
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Tarefa</th>
                                    <th>Categoria</th>
                                    <th>Criado por</th>
                                    <th>Descrição</th>
                                    <th>Inicio</th>
                                    <th>Termino</th>
                                    <th>Operações</th>
                                </tr>
                            </thead>
                            <tbody>

                                @foreach (var t in Model.ListagemTarefas)
                                {
                                    <tr>
                                        <td>@t.Titulo</td>
                                        <td>@t.Categoria</td>
                                        <th>@t.Descricao</th>
                                        <th>@t.DataHoraInicio</th>
                                        <td>@t.DataHoraFim</td>
                                        <td>
                                            @Html.ActionLink("Excluir", "ExcluirTarefa",
                                           new { id = t.Codigo },
                                           new { @class = "btn btn-danger btn-sm" })
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="7">
                                        Quantidade: @Model.ListagemTarefas.Count
                                    </td>

                                </tr>
                            </tfoot>
                        </table>

                    }
                    else
                    {
                        <h4>Nenhuma tarefa encontrada</h4>
                    }
                }

        </div>
</div>
