
@model Projeto_ONE.Models.HomeModelCadastro
   


<!DOCTYPE html>
<html>

<head>
    <meta name="viewport" content="width=device-width" />
    
    <title>Cadastro</title>
</head>
<body>
    @{
        Layout = "~/Views/Shared/_Layout.cshtml";
    }

    <h3>Cadastro de Usuarios</h3>
    @Html.ActionLink("Autenticar Usuario", "Login")
    <hr />

    @using (Html.BeginForm("Cadastro", "Home", FormMethod.Post))
    {
        <div>
            @Html.ValidationSummary()
        </div>

        @Html.LabelFor(u => u.Nome)<br />
        @Html.TextBoxFor(u => u.Nome)
        <br /><br />

        @Html.LabelFor(u => u.Login)<br />
        @Html.TextBoxFor(u => u.Login)
        <br /><br />

        @Html.LabelFor(u => u.Senha) <br />
        @Html.PasswordFor(u => u.Senha)
        <br /><br />

        @Html.LabelFor(u => u.SenhaConfirm)<br />
        @Html.PasswordFor(u => u.SenhaConfirm)
        <br /><br />

        <input type="submit" value="Cadastrar Usuario" />

        <p>
            @ViewBag.Mensagem
        </p>
    }
    <div>

    </div>



</body>

</html>